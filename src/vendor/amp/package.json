{
  "name": "amp-mcp-server",
  "version": "0.2.1",
  "description": "MCP server for CubeCoders AMP — control game-server instances from Claude and other MCP clients",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "amp-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "amp",
    "cubecoders",
    "game-server",
    "minecraft"
  ],
  "author": "Will Eddins",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neuralnexus/ampapi": "^1.0.19",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "jose": "^5.9.6",
    "pino": "^10.3.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
