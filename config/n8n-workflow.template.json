          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "32f28d8f-8462-493c-8649-0b656c5661ce",
      "name": "Require reviewed revision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        200
      ],
      "parameters": {
        "jsCode": "const h=$input.first().json; if(h.ok!==true || h.name!=='phunbot' || h.startupAppSha256!==\"a986f98c734c7e512a4a4a1b19e4a21e488080ec0e7e92ffd21f99f8cbe7edbe\") throw new Error('WAITING_FOR_OWNER_RELOAD: reviewed phunbot source is not loaded; no goal or memory model calls dispatched'); return $input.all();"
      }
    }
