{
  "name": "PhunBot candidate recovery (inactive template)",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Manual verification",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "schedule",
      "name": "Every five minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "webhook",
      "name": "Authorized verification",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "phunbot-candidate-maintenance",
        "authentication": "headerAuth",
        "responseMode": "lastNode"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "PhunBot candidate bearer"
        }
      }
    },
    {
      "id": "resume",
      "name": "Resume goals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Candidate configuration').first().json.baseUrl + '/api/resume' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "PhunBot candidate bearer"
        }
      }
    },
    {
      "id": "maintenance",
      "name": "Review memory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Candidate configuration').first().json.baseUrl + '/api/maintenance' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 150000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "PhunBot candidate bearer"
        }
      }
    },
    {
      "id": "validate",
      "name": "Validate results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "jsCode": "const r=$('Resume goals').first().json; const m=$input.first().json; if(r.ok!==true || m.ok!==true || !Array.isArray(m.checks)) throw new Error('phunbot maintenance postconditions failed'); return [{json:{ok:true,resumed:r.started,notes:m.notes,checks:m.checks}}];"
      }
    },
    {
      "id": "read-identity",
      "name": "Read deployed revision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        140,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Candidate configuration').first().json.baseUrl + '/health' }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "require-identity",
      "name": "Require reviewed revision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        200
      ],
      "parameters": {
        "jsCode": "const h=$input.first().json;\nconst c=$('Candidate configuration').first().json;\nif(!/^[a-f0-9]{40,64}$/.test(c.expectedGitRevision || '') ||\n   !/^[a-f0-9]{64}$/.test(c.expectedSourceSha256 || '') ||\n   !/^[a-f0-9]{64}$/.test(c.expectedAmpRuntimeSha256 || '') ||\n   h.ok!==true || h.name!=='phunbot' || h.sourceVerification!=='available' || h.sourceDrifted!==false ||\n   h.startupGitDirty!==false || h.currentGitDirty!==false || h.ampLaunchCorrespondence!=='on-disk-only' ||\n   h.startupGitRevision!==c.expectedGitRevision || h.currentGitRevision!==c.expectedGitRevision ||\n   h.startupSourceSha256!==c.expectedSourceSha256 || h.currentSourceSha256!==c.expectedSourceSha256 ||\n   h.startupAmpRuntimeSha256!==c.expectedAmpRuntimeSha256 || h.currentAmpRuntimeSha256!==c.expectedAmpRuntimeSha256)\n  throw new Error('Candidate identity mismatch or unavailable; recovery not dispatched');\nreturn $input.all();"
      }
    },
    {
      "id": "candidate-configuration",
      "name": "Candidate configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        200
      ],
      "parameters": {
        "jsCode": "return [{json:{baseUrl:'https://phunbot.example.invalid',expectedGitRevision:'REPLACE_WITH_REVIEWED_REVISION',expectedSourceSha256:'REPLACE_WITH_SOURCE_SHA256',expectedAmpRuntimeSha256:'REPLACE_WITH_BUILT_AMP_SHA256'}}];"
      }
    }
  ],
  "connections": {
    "Manual verification": {
      "main": [
        [
          {
            "node": "Candidate configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every five minutes": {
      "main": [
        [
          {
            "node": "Candidate configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorized verification": {
      "main": [
        [
          {
            "node": "Candidate configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resume goals": {
      "main": [
        [
          {
            "node": "Review memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Review memory": {
      "main": [
        [
          {
            "node": "Validate results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read deployed revision": {
      "main": [
        [
          {
            "node": "Require reviewed revision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require reviewed revision": {
      "main": [
        [
          {
            "node": "Resume goals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Candidate configuration": {
      "main": [
        [
          {
            "node": "Read deployed revision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 180,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none"
  }
}
