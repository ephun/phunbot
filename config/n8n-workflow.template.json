    {
      "id": "validate",
      "name": "Validate results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "jsCode": "const r=$('Resume goals').first().json; const m=$input.first().json; if(r.ok!==true || m.ok!==true || !Array.isArray(m.checks)) throw new Error('phunbot maintenance postconditions failed'); return [{json:{ok:true,resumed:r.started,notes:m.notes,checks:m.checks}}];"
      }
    },
