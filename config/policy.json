{
  "provider": "litellm",
  "roles": {
    "executor": "fleet-fast",
    "reviewer": "fleet-deep",
    "vision": "fleet-vision",
    "embedding": "fleet-embed"
  },
  "limits": {
    "turns": 80,
    "sliceMs": 600000,
    "maxModelTurns": 80,
    "maxRetries": 3,
    "maxActiveGoals": 2,
    "maxOpenSessions": 3,
    "maxOutputTokens": 8192,
    "dependencyProbeMs": 300000,
    "retryBackoffMs": 5000,
    "maxBackoffMs": 900000
  },
  "maintenance": {
    "maxPairsPerRun": 2,
    "reviewTimeoutMs": 20000,
    "maxReviewAttempts": 2
  },
  "routing": {
    "enabled": true,
    "reviewFailuresBeforeEscalation": 3,
    "escalationModel": "fleet-deep",
    "visionEscalationModel": null
  }
}
